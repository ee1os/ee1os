<?xml version="1.0" encoding="UTF-8"?>
<!-- Local manifest for the full build tree: redirects the repos we change to the
     ee1os forks, branch envs-17. Symlink into <tree>/.repo/local_manifests/envs.xml.
     Everything else follows the GrapheneOS manifest the tree is initialised from (a release tag). -->
<manifest>
  <remote name="fork" fetch="https://github.com/ee1os/"/>
  <extend-project name="platform_build" remote="fork" revision="refs/heads/envs-17"/>
  <extend-project name="platform_frameworks_base" remote="fork" revision="refs/heads/envs-17"/>
  <extend-project name="platform_packages_apps_Settings" remote="fork" revision="refs/heads/envs-17"/>
  <extend-project name="platform_packages_apps_SetupWizard2" remote="fork" revision="refs/heads/envs-17"/>
  <extend-project name="platform_packages_apps_Updater" remote="fork" revision="refs/heads/envs-17"/>
  <extend-project name="platform_system_sepolicy" remote="fork" revision="refs/heads/envs-17"/>
</manifest>
