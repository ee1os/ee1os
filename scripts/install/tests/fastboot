#!/usr/bin/env bash
# A fake fastboot for the install script tests. State lives in $FAKE_DIR:
#   product      codename the phone reports (default husky)
#   unlocked     yes / no
#   devices      how many phones are connected (default 1)
#   fail         a partition whose flash fails
#   perm         if present, "devices" reports no permissions
# Every call is appended to $FAKE_DIR/calls.
d=${FAKE_DIR:?}
echo "$*" >> "$d/calls"
val() { if [ -f "$d/$1" ]; then cat "$d/$1"; else echo "$2"; fi; }

[ "${1:-}" = -s ] && shift 2

case "${1:-}" in
    --version)
        echo "fastboot version 37.0.1-14290000"
        echo "Installed as $0" ;;
    devices)  # fastboot 37 prints "<serial><tab><space>fastboot"
        if [ -f "$d/perm" ]; then printf 'no permissions (missing udev rules?)\tfastboot\n'; exit 0; fi
        n=$(val devices 1); i=0
        while [ "$i" -lt "$n" ]; do printf '3A1B2C3D4E%02d\t fastboot\n' "$i"; i=$((i + 1)); done ;;
    getvar)
        case $2 in
            product) v=$(val product husky) ;;
            unlocked) v=$(val unlocked no) ;;
            is-userspace) v=no ;;
            slot-count) v=2 ;;
            current-slot) v=a ;;
            *) v="test" ;;
        esac
        echo "$2: $v" >&2
        echo "Finished. Total time: 0.001s" >&2 ;;
    flashing)
        case $2 in
            get_unlock_ability) echo "(bootloader) get_unlock_ability: $(val ability 1)" >&2 ;;
            unlock) echo yes > "$d/unlocked" ;;
            lock) echo no > "$d/unlocked" ;;
        esac
        echo "OKAY [  0.050s]" >&2 ;;
    flash|erase)
        if [ "$(val fail '')" = "$2" ]; then
            echo "FAILED (remote: 'Partition $2 error')" >&2
            exit 1
        fi
        echo "Writing '$2'  OKAY [  0.100s]" >&2 ;;
    *) echo "OKAY" >&2 ;;
esac
exit 0
